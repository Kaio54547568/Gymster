{
  "name": "gymster",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:backend": "node backend/server.js",
    "dev:speech": "speech_service\\.venv\\Scripts\\python.exe -m uvicorn app:app --host 127.0.0.1 --port 8000 --app-dir speech_service",
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test:backend": "vitest run backend",
    "test:backend:watch": "vitest backend",
    "test:speech": "speech_service\\.venv\\Scripts\\pytest speech_service/tests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/design.md": "^0.1.1",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "supertest": "^7.2.2",
    "vitest": "^4.1.9"
  }
}
